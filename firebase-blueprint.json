{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated ORBITA AI user profile linked to Firebase Authentication.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID matching document ID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 180,
          "description": "Verified Google account email."
        },
        "profileImage": {
          "type": "string",
          "maxLength": 512,
          "description": "Optional Google avatar URL."
        },
        "themePreference": {
          "type": "string",
          "enum": ["light", "dark", "system"],
          "description": "User interface theme preference."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was last updated."
        }
      },
      "required": ["uid", "name", "email", "themePreference", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "Owner-isolated user profile metadata synced from Firebase Authentication."
    }
  }
}
