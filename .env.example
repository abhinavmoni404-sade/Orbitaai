# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# ADMIN_EMAIL: Comma-separated email addresses granted initial Administrator access on sign-in.
ADMIN_EMAIL=

# CASHFREE_APP_ID & CASHFREE_SECRET_KEY: Cashfree Payment Gateway API credentials (server-side only).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

